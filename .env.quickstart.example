# Только своё отдельное сообщество VK. Не копируйте production .env.
VK_GROUP_ID=
VK_TOKEN=
# Числовой VK ID первого администратора — свой или проверенный сотрудник.
ADMIN_VK_ID=
LLM_API_KEY=
# Свой случайный пароль >=24 символов; не меняйте после создания БД.
POSTGRES_PASSWORD=REPLACE_WITH_UNIQUE_RANDOM_PASSWORD_24_CHARS
# Необязательно: отдельный доступ только к Excel. Не даёт роль сотрудника.
EXCEL_ACCESS_CODE=
