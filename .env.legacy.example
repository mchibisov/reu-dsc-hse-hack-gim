# Copy to .env. Never commit .env. Use URL-safe password characters (letters/digits).
POSTGRES_PASSWORD=replace_with_a_long_random_password
DATABASE_URL=postgresql://gim:replace_with_a_long_random_password@localhost:5432/gim
VK_TOKEN=
VK_GROUP_ID=
VK_API_VERSION=5.199
ADMIN_VK_IDS=
CAMPAIGN=autumn-2026
# Optional. Empty value starts the questionnaire immediately.
# Use literal \n for a multiline message.
CONSENT_TEXT=
WORKER_CONCURRENCY=4
STORAGE_DIR=./data/files
# Optional team endpoint instead of calling the model directly.
SCORING_URL=
SCORING_TOKEN=
# Optional team endpoint: one next question or finish, after every answer.
FOLLOWUP_URL=
SERVICE_TOKEN=
# Direct Mistral/OpenRouter/OpenAI-compatible API (base URL without /chat/completions).
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_API_KEY=
LLM_MODEL=
# Maximum total AI clarifications, not per direction (0 disables clarifications).
MAX_FOLLOWUPS=3
# Required approved criteria JSON for both direct and team-endpoint final scoring.
RUBRIC_PATH=
# Empty means all job kinds; Compose separates report-worker automatically.
JOB_KINDS=
# Restrict questionnaire to ADMIN_VK_IDS during private testing, if needed.
TEST_MODE=false
