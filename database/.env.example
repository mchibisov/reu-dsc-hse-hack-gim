# No real credentials in Git. URL-encode passwords. Cloud DSNs: sslmode=require.
LOCAL_POSTGRES_PASSWORD=replace-with-local-secret
DATABASE_ADMIN_URL=postgresql://postgres:REPLACE@db:5432/gim
DATABASE_BOT_URL=postgresql://gim_bot_login:REPLACE@db:5432/gim
DATABASE_WORKER_URL=postgresql://gim_worker_login:REPLACE@db:5432/gim
DATABASE_STAFF_URL=postgresql://gim_staff_login:REPLACE@db:5432/gim
VK_GROUP_ID=SET_COMMUNITY_ID
# Supabase project in Frankfurt; only synthetic demo data uploaded.
SUPABASE_URL=https://bytwrnvnujzscfjfmdhm.supabase.co
SUPABASE_STORAGE_KEY=SET_ONLY_ON_TRUSTED_SERVER
SUPABASE_BUCKET=gim-private
GIM_HANDLERS_MODULE=team_handlers
