# Copy to .env. Never commit .env. Use URL-safe password characters (letters/digits).
POSTGRES_PASSWORD=replace_with_a_long_random_password
DATABASE_URL=postgresql://gim:replace_with_a_long_random_password@localhost:5432/gim
VK_TOKEN=
VK_GROUP_ID=
VK_API_VERSION=5.199
ADMIN_VK_IDS=
CAMPAIGN=autumn-2026
# Optional. Empty value starts the questionnaire immediately.
# Use literal \n for a multiline message.
CONSENT_TEXT=
WORKER_CONCURRENCY=4
STORAGE_DIR=./data/files
# Full POST endpoint of the team's scoring-service; no fake fallback score.
SCORING_URL=
SCORING_TOKEN=
# Optional team service for personalized follow-up generation/selection.
FOLLOWUP_URL=
SERVICE_TOKEN=
# Empty means all job kinds; Compose separates report-worker automatically.
JOB_KINDS=
# Restrict questionnaire to ADMIN_VK_IDS during private testing, if needed.
TEST_MODE=false
