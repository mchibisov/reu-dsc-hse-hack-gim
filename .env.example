# Copy to .env. Never commit .env. Use URL-safe password characters (letters/digits).
POSTGRES_PASSWORD=replace_with_a_long_random_password
DATABASE_URL=postgresql://gim:replace_with_a_long_random_password@localhost:5432/gim
VK_TOKEN=
VK_GROUP_ID=
VK_API_VERSION=5.199
ADMIN_VK_IDS=
CAMPAIGN=autumn-2026
# Text approved by the museum, including purpose, operator, storage and withdrawal.
# Empty value disables intake. Escape multiline text using one line in this file.
CONSENT_TEXT=
WORKER_CONCURRENCY=4
STORAGE_DIR=./data/files
# Full POST endpoint of the team's scoring-service; no fake fallback score.
SCORING_URL=
SCORING_TOKEN=
