# Скопировать в .env. Не добавлять .env в Git.
VK_TOKEN=
VK_GROUP_ID=
ADMIN_IDS=
# Сгенерировать длинные случайные значения; пароль БД — hex без спецсимволов URL.
POSTGRES_PASSWORD=
INTERNAL_API_KEY=
DATABASE_URL=postgresql+asyncpg://gim:REPLACE_WITH_POSTGRES_PASSWORD@postgres:5432/gim
REDIS_URL=redis://redis:6379/0
GATEWAY_URL=http://llm-gateway:8100
# Текущий запуск без LLM: оба значения оставить пустыми.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_FALLBACK_MODEL=
LLM_TIMEOUT=12
FOLLOWUP_TIMEOUT=3
LLM_CONCURRENCY=4
MAX_FOLLOWUPS=3
WORKER_MAX_JOBS=5
BOT_CONCURRENCY=20
# До реального запуска музей должен согласовать текст и условия обработки.
CONSENT_TEXT=Согласны на обработку анкеты по политике https://shm.ru/politika-konfidentsialnosti/?
CONSENT_VERSION=museum-policy-2026-10-21
