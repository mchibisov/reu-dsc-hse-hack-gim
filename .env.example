# Скопировать в .env. Не добавлять .env в Git.
VK_TOKEN=
VK_GROUP_ID=0
ADMIN_IDS=
# Только для Docker/PostgreSQL; при запуске на ПК с SQLite эти два значения не нужны.
POSTGRES_PASSWORD=
INTERNAL_API_KEY=
DATABASE_URL=sqlite+aiosqlite:///gim.db
GATEWAY_URL=
# Текущий запуск без LLM: оба значения оставить пустыми.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_FALLBACK_MODEL=
LLM_TIMEOUT=12
FOLLOWUP_TIMEOUT=3
LLM_CONCURRENCY=4
MAX_FOLLOWUPS=3
WORKER_MAX_JOBS=5
WORKER_POLL_INTERVAL=1
BOT_CONCURRENCY=20
# До реального запуска музей должен согласовать текст и условия обработки.
CONSENT_TEXT=Согласны на обработку анкеты по политике https://shm.ru/politika-konfidentsialnosti/?
CONSENT_VERSION=museum-policy-2026-10-21
