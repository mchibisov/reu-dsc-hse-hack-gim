# Скопируйте в .env. Не коммитьте заполненный файл.
VK_TOKEN=
VK_GROUP_ID=242476311
RECRUITMENT_ID=
# Три разных runtime login, созданных оператором БД. Не DATABASE_ADMIN_URL.
DATABASE_BOT_URL=
DATABASE_WORKER_URL=
DATABASE_STAFF_URL=
CONSENT_VERSION=gim-v1
WORKER_CONCURRENCY=4
MAX_FOLLOWUPS=3
MAX_ANSWER_LENGTH=2000
STORAGE_DIR=runtime/files
VK_API_VERSION=5.199
LLM_BASE_URL=https://polza.ai/api/v1
LLM_API_KEY=
LLM_MODEL=deepseek/deepseek-v4.1-flash-1017
LLM_REASONING_EFFORT=low

# Только доступ к Excel по /export КОД; не роль сотрудника
EXCEL_ACCESS_CODE=

# Final MVP: evidence reports and expectation check enabled; experimental scorer stays OFF.
ENHANCED_REPORTS=true
EXPECTATIONS_CHECK=true
ANALYSIS_RUBRIC_PATH=
